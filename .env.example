# The CLI does NOT auto-load .env. Export variables, or let Docker Compose load it.
# Generate real random keys; placeholders below are not deployment secrets.
CITEPAPER_API_KEYS={"replace-with-a-random-key-at-least-32-characters":"demo"}
CITEPAPER_DATABASE=.citepaper/citepaper.sqlite3
CITEPAPER_ALLOW_ARXIV=0
CITEPAPER_EMBEDDED_WORKER=0
# Empty model configuration selects fully offline EXTRACTIVE mode.
CITEPAPER_LLM_BASE_URL=
CITEPAPER_LLM_MODEL=
CITEPAPER_LLM_API_KEY=
CITEPAPER_LLM_TIMEOUT=45
